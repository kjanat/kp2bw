{ // git ls-remote https://github.com/kjanat/kjanat.git HEAD | awk '{print substr($1, 1, 8)}' | xargs -r -I{} sed -i -E 's#(github\.com/kjanat/kjanat/raw/)[0-9a-f]{4,40}(/configs/dprint\.remote\.json)#\1{}\2#g' .dprint.jsonc
	"extends": "https://github.com/kjanat/kjanat/raw/ba61f5cb/configs/dprint.remote.json",
	"dockerfile": { "associations": ["!*.ts"] },
	"excludes": ["**/*fixtures*/**", "**/*snapshots*/**"],
	"markdown": {
		"lineWidth": 120,
		"textWrap": "always",
	},
	"ruff": { "preview": true, "overrides": [{ "files": ["packages/**"], "preview": false }] },
	"exec": {
		"cwd": "${configDir}",
		"commands": [{
			"command": "tombi format - --stdin-filename {{file_path}}",
			"exts": ["toml"],
			"cacheKeyFiles": ["tombi.toml"],
			"setupCommand": "npm i -g tombi",
		}],
	},
	"plugins": [
		"https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa",
	],
}
