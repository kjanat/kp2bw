{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"forkProcessing": "enabled",
	"automerge": true,
	"labels": ["dependencies"],
	"rebaseWhen": "conflicted",
	"gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
	"ignorePaths": ["**/node_modules/**"],
	"github-actions": { "enabled": false },
	"customManagers": [
		{
			"customType": "regex",
			"description": "Extract the top-level Bun catalogs that the built-in manager does not read.",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStringsStrategy": "recursive",
			"matchStrings": [
				"\"catalogs?\"\\s*:\\s*\\{[\\s\\S]*?\\n\\t\\}",
				"\"(?<depName>[^\"\\n]+)\"\\s*:\\s*\"(?:npm:(?<packageName>@?[^\"\\n]+?)@)?(?<currentValue>[^\"\\n:]+)\""
			],
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.tool-versions$/"],
			"matchStrings": ["(?:^|\\n)github:(?<depName>\\S+)\\s+(?<currentValue>\\S+)"],
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v?(?<version>.+)$",
			"versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-kjanat)?$"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.tool-versions$/"],
			"matchStrings": ["(?:^|\\n)npm:(?<depName>\\S+)\\s+(?<currentValue>\\S+)"],
			"datasourceTemplate": "npm"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.tool-versions$/"],
			"matchStrings": ["(?:^|\\n)(?<depName>ruff|ty|tombi)\\s+(?<currentValue>\\S+)"],
			"datasourceTemplate": "pypi"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.tool-versions$/"],
			"matchStrings": ["(?:^|\\n)crane\\s+(?<currentValue>\\S+)"],
			"depNameTemplate": "google/go-containerregistry",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.+)$"
		}
	],
	"packageRules": [
		{
			"matchManagers": ["pep621"],
			"addLabels": ["python:uv"]
		},
		{
			"matchFileNames": ["package.json", "docs/package.json"],
			"addLabels": ["javascript"]
		},
		{
			"matchManagers": ["dockerfile", "docker-compose"],
			"addLabels": ["docker"]
		},
		{
			"matchDepNames": ["uv", "ghcr.io/astral-sh/uv", "uv_build"],
			"groupName": "uv"
		},
		{
			"matchDepNames": ["runner-run", "kjanat/runner"],
			"groupName": "runner"
		}
	]
}
