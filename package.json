{
	"private": true,
	"type": "module",
	"workspaces": ["docs"],
	"scripts": {
		"basedpyright": "uv run basedpyright",
		"dprint:update": "dprint config update --yes --recursive",
		"fmt": "dprint fmt",
		"fmt:ci": "run fmt --allow-no-files --diff --excludes '.github'",
		"ruff": "uv run ruff",
		"ruff:check": "run ruff check",
		"ruff:check:fix": "run ruff check --fix",
		"ruff:format": "run ruff format",
		"ty": "uv run ty",
		"ty:check": "run ty check",
		"typecheck": "run -q tsc7 --noEmit",
		"typecheck:tsc": "tsc --noEmit"
	},
	"devDependencies": {
		"@actions/github-script": "catalog:actions",
		"@bitwarden/cli": "catalog:ci",
		"@types/bun": "catalog:",
		"dprint": "catalog:",
		"runner-run": "catalog:",
		"tombi": "catalog:",
		"tsc7": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.2",
	"catalog": {
		"@types/bun": "^1.4",
		"dprint": "^0.57",
		"tombi": "^1.5",
		"runner-run": "^0.26.1",
		"typescript": "<7",
		"tsc7": "npm:typescript@>=7"
	},
	"catalogs": {
		"ci": {
			"@bitwarden/cli": "^2026.8.0"
		},
		"actions": {
			"@actions/github-script": "github:actions/github-script"
		}
	}
}
