{
	"private": true,
	"type": "module",
	"workspaces": ["docs"],
	"scripts": {
		"basedpyright": "uv run basedpyright",
		"dprint:update": "dprint config update --yes --recursive",
		"fmt": "dprint fmt",
		"fmt:ci": "run fmt --allow-no-files --diff --excludes '.github'",
		"ruff": "uv run ruff",
		"ruff:check": "run ruff check",
		"ruff:check:fix": "run ruff check --fix",
		"ruff:format": "run ruff format",
		"ty": "uv run ty",
		"ty:check": "run ty check",
		"typecheck": "run -q tsc7 --noEmit",
		"typecheck:tsc": "tsc --noEmit"
	},
	"devDependencies": {
		"@actions/github-script": "github:actions/github-script",
		"@bitwarden/cli": "^2026.7.0",
		"@types/bun": "^1.3.14",
		"dprint": "^0.55.2",
		"runner-run": "catalog:",
		"tombi": "^1.4.1",
		"tsc7": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"runner-run": "^0.25.1",
		"typescript": "<7",
		"tsc7": "npm:typescript@^7"
	}
}
